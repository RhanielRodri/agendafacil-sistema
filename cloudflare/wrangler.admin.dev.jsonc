// Configuração exclusiva do smoke local do painel. Não publicar: a entrada
// `admin-worker/src/dev.ts` simula o Cloudflare Access. A configuração de
// publicação é `wrangler.admin.jsonc`, cujo `main` é `admin-worker/src/index.ts`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agendafacil-cf1-admin-smoke-local",
  "main": "admin-worker/src/dev.ts",
  "compatibility_date": "2026-07-21",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agendafacil-cf1-local",
      "database_id": "local-development-only",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ACCESS_TEAM_DOMAIN": "example.cloudflareaccess.com",
    "ACCESS_POLICY_AUD": "local-test-audience",
    "ACCESS_DEV_EMAIL": "smoke-studio@access.invalid"
  },
  "assets": {
    "directory": "./admin-worker/assets",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  }
}
