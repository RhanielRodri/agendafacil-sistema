{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node", "@cloudflare/workers-types", "@cloudflare/vitest-pool-workers/types"]
  },
  "include": ["admin-worker/src", "public-worker/src", "shared/src", "tests", "vitest.config.ts"]
}
