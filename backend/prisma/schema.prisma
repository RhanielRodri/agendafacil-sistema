generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentHistoryType {
  CREATED
  CONFIRMED
  CANCELLED
  RESCHEDULED_FROM
  RESCHEDULED_TO
  COMPLETED
  NO_SHOW
  STATUS_CHANGED
}

enum AppointmentActorType {
  ADMIN
  CUSTOMER
  SYSTEM
}

enum AppointmentTokenPurpose {
  MANAGE
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  LOST
}

enum LeadSource {
  BOOKING
  WAITLIST
  EVALUATION
  CONTACT
  ABANDONED_BOOKING
  MANUAL
}

enum LeadPriority {
  LOW
  NORMAL
  HIGH
}

enum FollowUpStatus {
  OPEN
  COMPLETED
  CANCELLED
}

enum FollowUpType {
  CONTACT
  RETURN
  EVALUATION
  WAITLIST
  OTHER
}

enum RelationshipHistoryType {
  CLIENT_CREATED
  CLIENT_UPDATED
  LEAD_CREATED
  LEAD_STATUS_CHANGED
  LEAD_CONVERTED
  LEAD_LOST
  LEAD_PRIORITY_CHANGED
  LEAD_OWNER_CHANGED
  LEAD_QUALIFICATION_UPDATED
  FOLLOW_UP_CREATED
  FOLLOW_UP_COMPLETED
  FOLLOW_UP_CANCELLED
  APPOINTMENT_LINKED
  NOTE_ADDED
}

enum RelationshipActorType {
  ADMIN
  CUSTOMER
  SYSTEM
}

model Tenant {
  id                    Int                        @id @default(autoincrement())
  slug                  String                     @unique
  name                  String
  active                Boolean                    @default(true)
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  services              Service[]
  professionals         Professional[]
  appointments          Appointment[]
  businessHours         BusinessHours[]
  blockedDates          BlockedDate[]
  professionalSchedules ProfessionalSchedule[]
  scheduleBlocks        ScheduleBlock[]
  adminUsers            AdminUser[]
  appointmentHistory    AppointmentHistoryEvent[]
  appointmentTokens     AppointmentAccessToken[]
  clients               Client[]
  leads                 Lead[]
  followUps             FollowUp[]
  relationshipHistory   RelationshipHistoryEvent[]
}

model AdminUser {
  id                 Int            @id @default(autoincrement())
  tenantId           String
  email              String
  name               String
  passwordHash       String
  active             Boolean        @default(true)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  tenant             Tenant         @relation(fields: [tenantId], references: [slug])
  sessions           AdminSession[]
  createdFollowUps   FollowUp[]     @relation("FollowUpCreator")
  completedFollowUps FollowUp[]     @relation("FollowUpCompleter")
  ownedFollowUps     FollowUp[]     @relation("FollowUpOwner")
  ownedLeads         Lead[]         @relation("LeadOwner")
  lostLeads          Lead[]         @relation("LeadLostBy")

  @@unique([tenantId, email])
  @@unique([id, tenantId])
  @@index([tenantId, active])
}

model AdminSession {
  id         Int       @id @default(autoincrement())
  userId     Int
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  user       AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Service {
  id           Int           @id @default(autoincrement())
  tenantId     String        @default("studio-cut") @map("demoId")
  name         String
  description  String
  duration     Int
  price        Decimal       @db.Decimal(10, 2)
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  tenant       Tenant        @relation(fields: [tenantId], references: [slug])
  appointments Appointment[]
  leads        Lead[]

  @@unique([tenantId, name])
  @@unique([id, tenantId])
  @@index([tenantId, active])
}

model Professional {
  id             Int                    @id @default(autoincrement())
  tenantId       String                 @default("studio-cut") @map("demoId")
  name           String
  specialty      String
  photo          String
  active         Boolean                @default(true)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  tenant         Tenant                 @relation(fields: [tenantId], references: [slug])
  appointments   Appointment[]
  leads          Lead[]
  schedules      ProfessionalSchedule[]
  scheduleBlocks ScheduleBlock[]

  @@unique([tenantId, name])
  @@unique([id, tenantId])
  @@index([tenantId, active])
}

model Appointment {
  id                  Int                        @id @default(autoincrement())
  tenantId            String                     @map("demoId")
  serviceId           Int
  professionalId      Int
  clientId            Int
  leadId              Int?
  clientName          String
  clientPhone         String
  clientEmail         String?
  date                DateTime                   @db.Date
  time                String
  status              AppointmentStatus          @default(PENDING)
  cancellationReason  String?                    @db.VarChar(300)
  rescheduledFromId   Int?                       @unique
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  tenant              Tenant                     @relation(fields: [tenantId], references: [slug])
  service             Service                    @relation(fields: [serviceId], references: [id])
  professional        Professional               @relation(fields: [professionalId], references: [id])
  client              Client                     @relation(fields: [clientId, tenantId], references: [id, tenantId])
  originLead          Lead?                      @relation("AppointmentOriginLead", fields: [leadId, tenantId], references: [id, tenantId], onDelete: Restrict)
  convertedLead       Lead?                      @relation("LeadConversion")
  rescheduledFrom     Appointment?               @relation("AppointmentReschedule", fields: [rescheduledFromId], references: [id])
  rescheduledTo       Appointment?               @relation("AppointmentReschedule")
  historyEvents       AppointmentHistoryEvent[]
  accessTokens        AppointmentAccessToken[]
  relationshipHistory RelationshipHistoryEvent[]

  @@unique([id, tenantId])
  @@index([tenantId, date])
  @@index([date, professionalId])
  @@index([professionalId, date, time])
  @@index([tenantId, status, date])
  @@index([tenantId, clientId, date])
  @@index([tenantId, leadId])
}

model Client {
  id                  Int                        @id @default(autoincrement())
  tenantId            String
  name                String                     @db.VarChar(120)
  phone               String                     @db.VarChar(30)
  normalizedPhone     String                     @db.VarChar(15)
  email               String?                    @db.VarChar(254)
  normalizedEmail     String?                    @db.VarChar(254)
  notes               String?                    @db.VarChar(2000)
  firstContactAt      DateTime                   @default(now())
  lastContactAt       DateTime                   @default(now())
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  tenant              Tenant                     @relation(fields: [tenantId], references: [slug])
  appointments        Appointment[]
  leads               Lead[]
  followUps           FollowUp[]
  relationshipHistory RelationshipHistoryEvent[]

  @@unique([tenantId, normalizedPhone])
  @@unique([id, tenantId])
  @@index([tenantId, normalizedEmail])
  @@index([tenantId, lastContactAt])
}

model Lead {
  id                     Int                        @id @default(autoincrement())
  tenantId               String
  clientId               Int
  source                 LeadSource
  status                 LeadStatus                 @default(NEW)
  priority               LeadPriority               @default(NORMAL)
  ownerUserId            Int?
  serviceId              Int?
  professionalId         Int?
  interestSummary        String?                    @db.VarChar(500)
  qualification          Json?
  qualificationVersion   Int?
  dedupeKey              String                     @db.Char(64)
  lostReason             String?                    @db.VarChar(300)
  lostReasonNote         String?                    @db.VarChar(300)
  lostAt                 DateTime?
  lostByUserId           Int?
  convertedAt            DateTime?
  convertedAppointmentId Int?
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt
  tenant                 Tenant                     @relation(fields: [tenantId], references: [slug])
  client                 Client                     @relation(fields: [clientId, tenantId], references: [id, tenantId])
  service                Service?                   @relation(fields: [serviceId, tenantId], references: [id, tenantId], onDelete: Restrict)
  professional           Professional?              @relation(fields: [professionalId, tenantId], references: [id, tenantId], onDelete: Restrict)
  owner                  AdminUser?                  @relation("LeadOwner", fields: [ownerUserId, tenantId], references: [id, tenantId], onDelete: Restrict)
  lostBy                 AdminUser?                  @relation("LeadLostBy", fields: [lostByUserId, tenantId], references: [id, tenantId], onDelete: Restrict)
  sourceAppointments     Appointment[]              @relation("AppointmentOriginLead")
  convertedAppointment   Appointment?               @relation("LeadConversion", fields: [convertedAppointmentId, tenantId], references: [id, tenantId], onDelete: Restrict)
  followUps              FollowUp[]
  relationshipHistory    RelationshipHistoryEvent[]

  @@unique([id, tenantId])
  @@unique([convertedAppointmentId, tenantId])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, source, createdAt])
  @@index([tenantId, priority, status, createdAt])
  @@index([tenantId, ownerUserId, status, createdAt])
  @@index([tenantId, clientId, createdAt])
}

model FollowUp {
  id                Int            @id @default(autoincrement())
  tenantId          String
  clientId          Int
  leadId            Int?
  dueAt             DateTime
  type              FollowUpType
  status            FollowUpStatus @default(OPEN)
  note              String?        @db.VarChar(500)
  completedAt       DateTime?
  createdByUserId   Int
  completedByUserId Int?
  ownerUserId       Int?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  tenant            Tenant         @relation(fields: [tenantId], references: [slug])
  client            Client         @relation(fields: [clientId, tenantId], references: [id, tenantId])
  lead              Lead?          @relation(fields: [leadId, tenantId], references: [id, tenantId], onDelete: Restrict)
  createdBy         AdminUser      @relation("FollowUpCreator", fields: [createdByUserId], references: [id])
  completedBy       AdminUser?     @relation("FollowUpCompleter", fields: [completedByUserId], references: [id])
  owner             AdminUser?     @relation("FollowUpOwner", fields: [ownerUserId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@unique([id, tenantId])
  @@index([tenantId, status, dueAt])
  @@index([tenantId, clientId, createdAt])
  @@index([tenantId, leadId])
  @@index([tenantId, ownerUserId, status, dueAt])
}

model RelationshipHistoryEvent {
  id            Int                     @id @default(autoincrement())
  tenantId      String
  clientId      Int
  leadId        Int?
  appointmentId Int?
  type          RelationshipHistoryType
  actorType     RelationshipActorType
  actorId       Int?
  metadata      Json?
  createdAt     DateTime                @default(now())
  tenant        Tenant                  @relation(fields: [tenantId], references: [slug])
  client        Client                  @relation(fields: [clientId, tenantId], references: [id, tenantId])
  lead          Lead?                   @relation(fields: [leadId, tenantId], references: [id, tenantId], onDelete: Restrict)
  appointment   Appointment?            @relation(fields: [appointmentId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@index([tenantId, clientId, createdAt, id])
  @@index([tenantId, leadId, createdAt])
  @@index([tenantId, appointmentId])
}

model AppointmentHistoryEvent {
  id            Int                    @id @default(autoincrement())
  tenantId      String
  appointmentId Int
  type          AppointmentHistoryType
  fromStatus    AppointmentStatus?
  toStatus      AppointmentStatus?
  metadata      Json?
  actorType     AppointmentActorType
  actorId       Int?
  createdAt     DateTime               @default(now())
  tenant        Tenant                 @relation(fields: [tenantId], references: [slug])
  appointment   Appointment            @relation(fields: [appointmentId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@index([tenantId, appointmentId, createdAt])
}

model AppointmentAccessToken {
  id            Int                     @id @default(autoincrement())
  tenantId      String
  appointmentId Int
  tokenHash     String                  @unique @db.Char(64)
  purpose       AppointmentTokenPurpose @default(MANAGE)
  expiresAt     DateTime
  usedAt        DateTime?
  revokedAt     DateTime?
  createdAt     DateTime                @default(now())
  tenant        Tenant                  @relation(fields: [tenantId], references: [slug])
  appointment   Appointment             @relation(fields: [appointmentId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@index([tenantId, appointmentId])
  @@index([expiresAt])
}

model BusinessHours {
  id        Int     @id @default(autoincrement())
  tenantId  String  @map("demoId")
  dayOfWeek Int
  openTime  String
  closeTime String
  isOpen    Boolean @default(true)
  tenant    Tenant  @relation(fields: [tenantId], references: [slug])

  @@unique([tenantId, dayOfWeek])
}

model BlockedDate {
  id        Int      @id @default(autoincrement())
  tenantId  String   @map("demoId")
  date      DateTime @db.Date
  reason    String
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [slug])

  @@unique([tenantId, date])
}

model ProfessionalSchedule {
  id             Int          @id @default(autoincrement())
  tenantId       String
  professionalId Int
  dayOfWeek      Int
  startTime      String       @db.VarChar(5)
  endTime        String       @db.VarChar(5)
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  tenant         Tenant       @relation(fields: [tenantId], references: [slug])
  professional   Professional @relation(fields: [professionalId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([tenantId, professionalId, dayOfWeek, startTime, endTime])
  @@index([tenantId, professionalId, dayOfWeek])
}

model ScheduleBlock {
  id             Int           @id @default(autoincrement())
  tenantId       String
  professionalId Int?
  date           DateTime      @db.Date
  allDay         Boolean       @default(false)
  startTime      String?       @db.VarChar(5)
  endTime        String?       @db.VarChar(5)
  reason         String?       @db.VarChar(200)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  tenant         Tenant        @relation(fields: [tenantId], references: [slug])
  professional   Professional? @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([tenantId, date])
  @@index([tenantId, professionalId, date])
}
